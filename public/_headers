# Next.js Static Immutable Bundles (1 Year Cache)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Web Icons and Branding Assets
/icon*.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/apple-touch-icon*.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/favicon.ico
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/favicon.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/logo.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/og-image.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/manifest.json
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600

# RSS and Atom Feeds
/feed.xml
  Content-Type: application/xml; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600, s-maxage=86400

/rss.xml
  Content-Type: application/xml; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600, s-maxage=86400

# Land Solution mutable entry files must revalidate after a release.
/land-solution-demo/index.html
  Cache-Control: no-cache, max-age=0, must-revalidate
/land-solution-demo/flutter_bootstrap.js
  Cache-Control: no-cache, max-age=0, must-revalidate
/land-solution-demo/main.dart.js
  Cache-Control: no-cache, max-age=0, must-revalidate
/land-solution-demo/version.json
  Cache-Control: no-cache, max-age=0, must-revalidate
/land-solution-demo/flutter_service_worker.js
  Cache-Control: no-cache, max-age=0, must-revalidate
/land-solution-demo/assets/AssetManifest.bin
  Cache-Control: no-cache, max-age=0, must-revalidate
/land-solution-demo/assets/AssetManifest.bin.json
  Cache-Control: no-cache, max-age=0, must-revalidate
/land-solution-demo/assets/FontManifest.json
  Cache-Control: no-cache, max-age=0, must-revalidate
